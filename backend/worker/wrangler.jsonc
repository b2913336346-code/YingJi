{
  "name": "yingji-ai-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "LIVE_AI_ENABLED": "false",
    "UPSTREAM_MODE": "LIVE",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "BILLING_POLICY": "{\"id\":\"UNVERIFIED\",\"currency\":\"CNY\",\"verification\":\"UNVERIFIED\",\"inputMicrosPerMillion\":\"0\",\"cachedInputMicrosPerMillion\":\"0\",\"outputMicrosPerMillion\":\"0\",\"dailyBudgetMicros\":\"0\",\"totalBudgetMicros\":\"0\"}"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REQUEST_GATE",
        "class_name": "RequestGate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "a5-v1",
      "new_sqlite_classes": [
        "RequestGate"
      ]
    }
  ]
}
